DATABASE_URL="postgresql://user:password@ep-example-12345.region.aws.neon.tech/dbname?sslmode=require"

# Login con Microsoft (Azure AD / Microsoft Entra ID)
AUTH_SECRET="generar con: npx auth secret"
AUTH_MICROSOFT_ENTRA_ID_ID="client-id-del-app-registration"
AUTH_MICROSOFT_ENTRA_ID_SECRET="client-secret-del-app-registration"
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<TENANT_ID>/v2.0"
ALLOWED_EMAILS="persona1@dominio.com,persona2@dominio.com"

# SharePoint (Fase 3) - reusa las credenciales AUTH_MICROSOFT_ENTRA_ID_* de arriba,
# pero ese App Registration necesita ADEMAS permisos de aplicacion (Sites.Read.All o
# Files.Read.All) con consentimiento de administrador.
SHAREPOINT_HOSTNAME="tuempresa.sharepoint.com"
SHAREPOINT_SITE_PATH="/sites/Tesoreria"
SHAREPOINT_FOLDER_PATH="/Documentos compartidos/Consolidados"
SHAREPOINT_ARCHIVO_2026_PATH="/Documentos compartidos/Consolidados/CONSOLIDADO 2026.xlsx"
SHAREPOINT_ARCHIVO_OBRAS_PATH="/Documentos compartidos/Consolidados/CONSOLIDADO OBRAS.xlsx"

# RRHH: sincronización Presentismo -> Nómina (ver planificación en memoria/conversación)
# Reusa las credenciales AUTH_MICROSOFT_ENTRA_ID_* y SHAREPOINT_HOSTNAME/SITE_PATH de
# arriba, pero a diferencia de Consolidados/Alquileres (solo lectura) esta sync
# ESCRIBE en Nómina -> el App Registration necesita permiso de aplicacion
# Files.ReadWrite.All o Sites.ReadWrite.All (no solo *.Read.All) con consentimiento
# de administrador. Verificar en Azure Portal antes del primer run real (--dry-run
# no requiere el permiso de escritura).
SHAREPOINT_RRHH_FOLDER_PATH="/Documentos compartidos/RRHH"
SHAREPOINT_RRHH_PRESENTISMO_PATH="/Documentos compartidos/RRHH/Presentismo.xlsx"
SHAREPOINT_RRHH_NOMINA_PATH="/Documentos compartidos/RRHH/Nomina.xlsx"

# Control de Precios y Proveedores
# BLOB_READ_WRITE_TOKEN la genera Vercel automaticamente al crear un Blob store
# desde el dashboard (Storage > Blob) y la inyecta en produccion; para desarrollo
# local hay que copiarla manualmente (vercel env pull o el dashboard).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# API key de Google AI Studio (aistudio.google.com/apikey) - free tier.
GEMINI_API_KEY="tu-api-key-de-google-ai-studio"
# Alias que Google actualiza al modelo vigente de cada categoria - evita fijar un
# snapshot puntual que despues se da de baja (ya paso dos veces). Estrategia
# hibrida: se prueba con flash (rapido/barato) y solo si el resultado tiene pinta
# de estar mal se reprocesa con pro (mas lento, mas confiable en fotos dificiles).
GEMINI_MODEL_FLASH="gemini-flash-lite-latest"
GEMINI_MODEL_PRO="gemini-pro-latest"

# Cloudflare R2 (storage de comprobantes nuevos de control-precios - reemplaza a
# Vercel Blob para subidas nuevas por el limite de 1GB gratis de Blob; ver
# lib/control-precios/CLAUDE.md). Se crean en el dashboard de Cloudflare > R2 >
# Manage API Tokens, con permiso "Object Read & Write" scoped al bucket.
R2_ACCOUNT_ID="tu-account-id-de-cloudflare"
R2_ACCESS_KEY_ID="tu-access-key-id"
R2_SECRET_ACCESS_KEY="tu-secret-access-key"
R2_BUCKET_NAME="administraciondevoto"
